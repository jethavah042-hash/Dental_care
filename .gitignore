# =============================================
# Dental Care – Root .gitignore
# =============================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables — NEVER commit real secrets
.env
*.env.local

# Logs
logs/
*.log

# Runtime / OS
pids/
*.pid
*.seed
*.pid.lock
.DS_Store
Thumbs.db

# Build output
dist/
build/

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Coverage
coverage/
.nyc_output/
